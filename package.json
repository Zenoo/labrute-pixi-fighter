{
  "name": "labrute-pixi-fighter",
  "version": "1.0.18",
  "description": "PixiJS fighter animations and SWF symbol data for LaBrute.",
  "main": "dist/Symbols.js",
  "module": "dist/Symbols.mjs",
  "types": "dist/Symbols.d.ts",
  "scripts": {
    "build": "rollup --config && rollup --config rollup-declarations.config.mjs && node -e \"require('fs').rmSync('dist/src', { recursive: true, force: true })\"",
    "test": "webpack serve --mode development",
    "deploy": "npm publish",
    "setup:swf": "node scripts/setup-swf.cjs",
    "export:swf": "node scripts/export-swf.cjs",
    "test:unit": "node --test test/*.test.cjs test/*.test.mjs",
    "prepublishOnly": "npm run build && npm run test:unit",
    "test:packaging": "node --test test/packaging.test.cjs",
    "test:browser": "node test/browser.cjs",
    "test:comparison": "node test/comparison.cjs",
    "benchmark": "node test/performance.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zenoo/labrute-pixi-fighter.git"
  },
  "bugs": {
    "url": "https://github.com/Zenoo/labrute-pixi-fighter/issues"
  },
  "homepage": "https://github.com/Zenoo/labrute-pixi-fighter#readme",
  "keywords": [
    "twinoid",
    "muxxu",
    "motion-twin",
    "mybrute",
    "labrute",
    "parser",
    "fla",
    "xml",
    "pixi",
    "fighter",
    "animation"
  ],
  "author": "Zenoo",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.17.8",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-typescript": "^7.16.7",
    "@rollup/plugin-json": "^6.0.1",
    "@ruffle-rs/ruffle": "0.7.1",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "babel-loader": "^8.2.3",
    "dotenv": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-prettier": "^3.1.4",
    "html-webpack-plugin": "^5.5.0",
    "pixi.js": "^8.19.0",
    "rollup": "^4.2.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "terser": "5.31.6",
    "typescript": "^4.6.3",
    "webpack": "^5.65.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "files": [
    "dist/Symbols.js",
    "dist/Symbols.mjs",
    "dist/symbol-data.cjs",
    "dist/Symbols.d.ts",
    "dist/Symbols.d.cts",
    "dist/Symbols.d.mts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/Symbols.d.mts",
        "default": "./dist/Symbols.mjs"
      },
      "require": {
        "types": "./dist/Symbols.d.cts",
        "default": "./dist/Symbols.js"
      }
    },
    "./dist/Symbols.js": {
      "types": "./dist/Symbols.d.cts",
      "default": "./dist/Symbols.js"
    },
    "./package.json": "./package.json"
  }
}
